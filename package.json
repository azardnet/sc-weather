{
  "name": "sc-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Weather app for large screen",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write . && tsc -b --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azardnet/sc-weather.git"
  },
  "license": "ISC",
  "homepage": "https://azardnet.github.io/sc-weather",
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@10.19.0"
}
