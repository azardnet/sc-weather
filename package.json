{
  "name": "sc-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Weather app for large screen",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write . && tsc -b --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azardnet/sc-weather.git"
  },
  "license": "ISC",
  "homepage": "https://azardnet.github.io/sc-weather",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.3.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@10.19.0"
}
